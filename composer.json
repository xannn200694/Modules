{
    "name": "xannn94/modules",
    "description": "Laravel 5 Modules",
    "keywords": ["modules", "laravel", "xannn94"],
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Alex Khan",
            "email": "axiles94@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/config": "13.40.*",
        "illuminate/console": "13.40.*",
        "illuminate/database": "13.40.*",
        "illuminate/filesystem": "13.40.*",
        "illuminate/support": "13.40.*",
        "laravel/framework": "13.40.*"
    },
    "autoload": {
        "psr-4": {
            "Xannn94\\Modules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xannn94\\Modules\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.50",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "wikimedia/composer-merge-plugin": "Allows the ability to create and merge composer.json files for your individual modules for module-specific dependency management."
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }

}
